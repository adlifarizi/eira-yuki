# Environment Mode (development | production)
NODE_ENV=development

# Logging Level (silent | fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# Google Gemini API Key (Required - get your free API key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Web Search API Key (Optional - get 1,000 free monthly searches at https://tavily.com)
# If left empty, Eira automatically falls back to free Wikipedia search.
TAVILY_API_KEY=

# Custom Chrome / Chromium Executable Path (Optional)
# Eira automatically detects default Chrome installations on Linux, macOS, and Windows.
# Specify this only if Chrome is installed in a custom directory or inside a Docker container.
# Examples:
#   Linux:   /usr/bin/chromium-browser
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=
